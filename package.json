{
  "name": "vscode-jev-linter",
  "displayName": "Jev Security Linter",
  "description": "Ultra-fast security vulnerability linter powered by TypeSafe Jev via OpenRouter.",
  "version": "0.8.0",
  "publisher": "camegone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camegone/vscode-jev-linter"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "AI"
  ],
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:php",
    "onLanguage:ruby",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jevLinter.scanCurrentFile",
        "title": "%command.scanCurrentFile%"
      },
      {
        "command": "jevLinter.clearDiagnostics",
        "title": "%command.clearDiagnostics%"
      },
      {
        "command": "jevLinter.clearCache",
        "title": "%command.clearCache%"
      },
      {
        "command": "jevLinter.scanWorkspace",
        "title": "%command.scanWorkspace%"
      },
      {
        "command": "jevLinter.scanCurrentFolder",
        "title": "%command.scanCurrentFolder%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "jevLinter.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.apiKey.description%"
        },
        "jevLinter.apiEndpoint": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1/systemone",
          "description": "%config.apiEndpoint.description%"
        },
        "jevLinter.model": {
          "type": "string",
          "default": "~typesafe/jev-latest",
          "description": "%config.model.description%"
        },
        "jevLinter.threshold": {
          "type": "number",
          "default": 0.65,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "%config.threshold.description%"
        },
        "jevLinter.concurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "%config.concurrency.description%"
        },
        "jevLinter.maxBranchCount": {
          "type": "number",
          "default": 8,
          "minimum": 2,
          "maximum": 64,
          "description": "%config.maxBranchCount.description%"
        },
        "jevLinter.minimumBlockSize": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 20,
          "description": "%config.minimumBlockSize.description%"
        },
        "jevLinter.overlapRatio": {
          "type": "number",
          "default": 0.15,
          "minimum": 0.0,
          "maximum": 0.4,
          "description": "%config.overlapRatio.description%"
        },
        "jevLinter.maxChunkChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "description": "%config.maxChunkChars.description%"
        },
        "jevLinter.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.scanOnSave.description%"
        },
        "jevLinter.warnUnresolvedBlocks": {
          "type": "boolean",
          "default": false,
          "description": "%config.warnUnresolvedBlocks.description%"
        },
        "jevLinter.enableCache": {
          "type": "boolean",
          "default": true,
          "description": "%config.enableCache.description%"
        },
        "jevLinter.cacheMaxEntries": {
          "type": "number",
          "default": 2000,
          "minimum": 100,
          "maximum": 20000,
          "description": "%config.cacheMaxEntries.description%"
        },
        "jevLinter.supportedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "javascript",
            "typescript",
            "javascriptreact",
            "typescriptreact",
            "python",
            "go",
            "php",
            "ruby",
            "java",
            "c",
            "cpp",
            "csharp",
            "rust"
          ],
          "description": "%config.supportedLanguages.description%"
        },
        "jevLinter.includePattern": {
          "type": "string",
          "default": "",
          "description": "%config.includePattern.description%"
        },
        "jevLinter.excludePattern": {
          "type": "string",
          "default": "node_modules|\\.git|dist|out|build|vendor",
          "description": "%config.excludePattern.description%"
        },
        "jevLinter.useGitignore": {
          "type": "boolean",
          "default": true,
          "description": "%config.useGitignore.description%"
        },
        "jevLinter.rules": {
          "type": "array",
          "description": "%config.rules.description%",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Rule identifier (e.g. security, typo, policy)"
              },
              "name": {
                "type": "string",
                "description": "Display name of the category"
              },
              "enabled": {
                "type": "boolean",
                "default": true,
                "description": "Whether this rule is active"
              },
              "severity": {
                "type": "string",
                "enum": ["Error", "Warning", "Information", "Hint"],
                "default": "Warning",
                "description": "Squiggly line severity in editor"
              },
              "target": {
                "type": "string",
                "description": "Target description prompt passed to Jev"
              },
              "message": {
                "type": "string",
                "description": "Prefix message displayed in the squiggly hover"
              }
            },
            "required": ["id", "name", "target", "message"]
          },
          "default": [
            {
              "id": "security",
              "name": "Security Vulnerabilities",
              "enabled": true,
              "severity": "Warning",
              "target": "security vulnerabilities, command injections, SQL injections, hardcoded credentials, unsanitized executions",
              "message": "Jev [Security]: Potential security risk/vulnerability detected"
            },
            {
              "id": "typo",
              "name": "Typos & Spelling",
              "enabled": false,
              "severity": "Information",
              "target": "spelling mistakes, obvious typos in comments, string literals, error messages, or identifiers",
              "message": "Jev [Typo]: Potential typo or spelling mistake detected"
            },
            {
              "id": "policy",
              "name": "Style & Policy Violations",
              "enabled": false,
              "severity": "Warning",
              "target": "policy violations, leftover debug prints/console.log, empty catch blocks swallowing errors, hardcoded environment URLs",
              "message": "Jev [Policy]: Potential policy violation or leftover debug code detected"
            },
            {
              "id": "redundancy",
              "name": "Redundancy & Dead Code",
              "enabled": false,
              "severity": "Information",
              "target": "redundant code, unreachable statements, unnecessary temporary variables, needlessly complex conditions, reinvented built-in utils",
              "message": "Jev [Redundancy]: Potential redundant or dead code detected"
            },
            {
              "id": "legacy",
              "name": "Legacy & Deprecated Practices",
              "enabled": false,
              "severity": "Information",
              "target": "deprecated syntax or outdated APIs, legacy idioms where modern language alternatives exist (e.g. var, callback hell)",
              "message": "Jev [Legacy]: Potential deprecated API or legacy syntax detected"
            },
            {
              "id": "performance",
              "name": "Performance & Resource Leaks",
              "enabled": false,
              "severity": "Warning",
              "target": "performance anti-patterns, N+1 queries in loops, unclosed file or connection resources, costly repeated allocations in loops",
              "message": "Jev [Perf]: Potential resource leak or performance pitfall detected"
            },
            {
              "id": "robustness",
              "name": "Robustness & Edge Cases",
              "enabled": false,
              "severity": "Warning",
              "target": "robustness issues, unhandled potential null/undefined dereferences, missing error handling for I/O, unprotected division by zero",
              "message": "Jev [Robustness]: Potential missing error handling or edge-case guard detected"
            }
          ]
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  }
}
