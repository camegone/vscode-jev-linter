{
  "name": "vscode-jev-linter",
  "displayName": "Jev Security Linter",
  "description": "Ultra-fast security vulnerability linter powered by TypeSafe Jev via OpenRouter.",
  "version": "0.2.0",
  "publisher": "camegone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/camegone/vscode-jev-linter"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "AI"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:go",
    "onLanguage:php",
    "onLanguage:ruby",
    "onLanguage:java",
    "onLanguage:c",
    "onLanguage:cpp",
    "onLanguage:csharp",
    "onLanguage:rust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jevLinter.scanCurrentFile",
        "title": "%command.scanCurrentFile%"
      },
      {
        "command": "jevLinter.clearDiagnostics",
        "title": "%command.clearDiagnostics%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "jevLinter.apiKey": {
          "type": "string",
          "default": "",
          "description": "%config.apiKey.description%"
        },
        "jevLinter.apiEndpoint": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1/systemone",
          "description": "%config.apiEndpoint.description%"
        },
        "jevLinter.model": {
          "type": "string",
          "default": "typesafe/jev-1.13",
          "description": "%config.model.description%"
        },
        "jevLinter.threshold": {
          "type": "number",
          "default": 0.65,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "%config.threshold.description%"
        },
        "jevLinter.windowLines": {
          "type": "number",
          "default": 30,
          "minimum": 10,
          "maximum": 200,
          "description": "%config.windowLines.description%"
        },
        "jevLinter.overlapLines": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 50,
          "description": "%config.overlapLines.description%"
        },
        "jevLinter.concurrency": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 10,
          "description": "%config.concurrency.description%"
        },
        "jevLinter.searchStrategy": {
          "type": "string",
          "enum": ["binarySearch", "slidingWindow"],
          "default": "binarySearch",
          "description": "%config.searchStrategy.description%"
        },
        "jevLinter.minimumBlockSize": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "maximum": 20,
          "description": "%config.minimumBlockSize.description%"
        },
        "jevLinter.overlapRatio": {
          "type": "number",
          "default": 0.15,
          "minimum": 0.0,
          "maximum": 0.4,
          "description": "%config.overlapRatio.description%"
        },
        "jevLinter.maxChunkChars": {
          "type": "number",
          "default": 60000,
          "minimum": 1000,
          "maximum": 200000,
          "description": "%config.maxChunkChars.description%"
        },
        "jevLinter.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "%config.scanOnSave.description%"
        },
        "jevLinter.supportedLanguages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "javascript",
            "typescript",
            "javascriptreact",
            "typescriptreact",
            "python",
            "go",
            "php",
            "ruby",
            "java",
            "c",
            "cpp",
            "csharp",
            "rust"
          ],
          "description": "%config.supportedLanguages.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.3"
  }
}
